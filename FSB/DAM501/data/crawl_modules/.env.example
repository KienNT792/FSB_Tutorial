# ========================================
# WEATHERBIT API KEYS (Multiple keys support)
# ========================================
# Get your API keys from: https://www.weatherbit.io/account/create
# You can add multiple keys separated by commas
# Script will automatically rotate between keys when hitting rate limits
# Format: key1,key2,key3,...
WEATHERBIT_API_KEYS=your_key_1,your_key_2,your_key_3

# ========================================
# LOCATION - HANOI COORDINATES
# ========================================
HANOI_LAT=21.0285
HANOI_LON=105.8542

# ========================================
# DATA STORAGE
# ========================================
# Directory to save CSV files (relative to script location)
DATA_DIR=../data_file
